# GEMINI_API_KEY: Required for Gemma 4 / Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional Custom RPC Overrides (Defaults to public chain RPCs if omitted)
ETH_RPC_URL="https://eth.llamarpc.com"
BSC_RPC_URL="https://bsc-dataseed.binance.org"
BASE_RPC_URL="https://mainnet.base.org"
ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"
POLYGON_RPC_URL="https://polygon-rpc.com"

# Optional GoPlus API credentials (public tier used automatically if omitted)
GOPLUS_APP_KEY=""
GOPLUS_APP_SECRET=""

# Optional Gemma 4 Model Preference (defaults to gemma-4-31b-it with fallback)
GEMMA_MODEL_ID="gemma-4-31b-it"

