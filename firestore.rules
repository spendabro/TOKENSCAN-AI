rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function parentUserExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
    }

    // Entity Blueprints
    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'authProvider', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'authProvider', 'createdAt', 'updatedAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
        (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
        data.authProvider is string && data.authProvider.size() <= 32 && (data.authProvider == 'google.com' || data.authProvider == 'apple.com') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
        data.createdAt is timestamp;
    }

    function isValidUserBookmark(data) {
      return data.keys().hasAll(['uid', 'networkId', 'contractAddress', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'networkId', 'contractAddress', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.networkId is string && data.networkId.size() <= 20 &&
        (data.networkId == 'ethereum' || data.networkId == 'bsc' || data.networkId == 'base' || data.networkId == 'arbitrum' || data.networkId == 'polygon' || data.networkId == 'solana') &&
        data.contractAddress is string && data.contractAddress.size() >= 20 && data.contractAddress.size() <= 80 &&
        data.createdAt is timestamp;
    }

    // Collection 1: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublicProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isOwner(userId) &&
        isValidId(userId) &&
        isValidUserPublicProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().authProvider == existing().authProvider &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);

      allow delete: if false;

      // Subcollection 1A: Isolated PII (/users/{userId}/private/{docId})
      match /private/{docId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId) && parentUserExists(userId);
        allow list: if false;

        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(docId) &&
          isValidUserPrivateInfo(incoming()) &&
          incoming().createdAt == request.time &&
          parentUserExists(userId);

        allow update: if false;
        allow delete: if false;
      }

      // Subcollection 1B: User Bookmarks (/users/{userId}/bookmarks/{bookmarkId})
      match /bookmarks/{bookmarkId} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(bookmarkId) && existing().uid == request.auth.uid && parentUserExists(userId);
        allow list: if isOwner(userId) && existing().uid == request.auth.uid;

        allow create: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(bookmarkId) &&
          isValidUserBookmark(incoming()) &&
          incoming().createdAt == request.time &&
          parentUserExists(userId);

        allow update: if false;

        allow delete: if isVerifiedUser() &&
          isOwner(userId) &&
          isValidId(userId) &&
          isValidId(bookmarkId) &&
          existing().uid == request.auth.uid &&
          parentUserExists(userId);
      }
    }
  }
}
